1. 	SELECT p.nombreProducto 
	FROM PRODUCTO p
	WHERE p.codProducto IN (SELECT d.codProducto 
				FROM DetVenta d 
				WHERE d.codVenta IN (Select v.codVenta 
						     FROM VENTA v 
						     WHERE DATEDIFF(NOW(),MOUNTH(v.fecha))>5) 
				); 
